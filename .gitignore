__pycache__/
*.pyc

# Run artifacts. run.py prints every full prompt, so a single 378-problem stdout
# log is multi-MB, and the --checkpoint JSONL carries the whole agent trace per
# problem and grows while a job runs. Track the distilled summaries instead.
yajat/logs/*
yajat/results/*

# Distilled summaries and folder labels -- these are the evidence, keep them.
!yajat/results/README.md
!yajat/results/arm_comparison.json
!yajat/results/padding_probe.json
!yajat/results/summary.json
!yajat/results/reference_summary.json
!yajat/results/ls_sweep.json
!yajat/results/scale_2x2.json
!yajat/results/realign_check_*.json
!yajat/results/padfix_comparison.json
!yajat/logs/README.md
!yajat/logs/analyze_reference.log
!yajat/logs/trace_latent_ls0.log
!yajat/logs/trace_latent_ls10.log

# Compatibility symlink repro -> yajat, kept only while jobs submitted under
# the old path are still in flight. Not part of the tree.
/repro
